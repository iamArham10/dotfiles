# ─────────────────────────────────────────────
#  Font
# ─────────────────────────────────────────────
# font-family = JetBrainsMono
font-family = FiraCode-Regular
font-size = 11.5
font-feature = -calt
font-feature = -liga

# ─────────────────────────────────────────────
#  Window
# ─────────────────────────────────────────────
window-padding-x = 1
window-padding-y = 1
window-padding-balance = true
# restore window size/position on relaunch
window-save-state = always

# ─────────────────────────────────────────────
#  Scrollback
# ─────────────────────────────────────────────
scrollback-limit = 10000

# ─────────────────────────────────────────────
#  Cursor
# ─────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ─────────────────────────────────────────────
#  Mouse
# ─────────────────────────────────────────────
mouse-hide-while-typing = true
focus-follows-mouse = false

# ─────────────────────────────────────────────
#  Splits — navigation
# ─────────────────────────────────────────────
keybind = ctrl+shift+nine=goto_split:previous
keybind = ctrl+shift+zero=goto_split:next

keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:top
keybind = ctrl+shift+down=goto_split:bottom

# ─────────────────────────────────────────────
#  Splits — creation & closing
# ─────────────────────────────────────────────
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+w=close_surface

# ─────────────────────────────────────────────
#  Splits — resizing
# ─────────────────────────────────────────────
keybind = ctrl+shift+equal=resize_split:up,10
keybind = ctrl+shift+semicolon=resize_split:left,10
keybind = ctrl+shift+apostrophe=resize_split:right,10

# ─────────────────────────────────────────────
#  Tabs
# ─────────────────────────────────────────────
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+period=next_tab
keybind = ctrl+shift+comma=previous_tab

# Jump to tab by number
keybind = ctrl+alt+one=goto_tab:1
keybind = ctrl+alt+two=goto_tab:2
keybind = ctrl+alt+three=goto_tab:3
keybind = ctrl+alt+four=goto_tab:4
keybind = ctrl+alt+five=goto_tab:5

# ─────────────────────────────────────────────
#  Scrollback
# ─────────────────────────────────────────────
keybind = ctrl+shift+k=scroll_page_up
keybind = ctrl+shift+j=scroll_page_down
keybind = ctrl+shift+g=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom

# ─────────────────────────────────────────────
#  Clipboard
# ─────────────────────────────────────────────
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# ─────────────────────────────────────────────
#  Font size (zoom)
# ─────────────────────────────────────────────
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# ─────────────────────────────────────────────
#  Miscellaneous
# ─────────────────────────────────────────────
keybind = ctrl+shift+f=toggle_fullscreen
