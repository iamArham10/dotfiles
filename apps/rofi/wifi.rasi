* {
    font: "JetBrainsMono Nerd Font 11";
    bg:        #1e1e2eee;
    bg-alt:    #313244;
    fg:        #cdd6f4;
    fg-dim:    #6c7086;
    accent:    #89b4fa;
    urgent:    #f38ba8;
    border:    #45475a;
    radius:    12px;
}

window {
    width:            380px;
    location:         center;
    background-color: @bg;
    border:           2px solid;
    border-color:     @border;
    border-radius:    @radius;
    padding:          0;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0;
    padding:          0;
}

inputbar {
    background-color: @bg-alt;
    text-color:       @fg;
    padding:          12px 16px;
    border-radius:    12px 12px 0 0;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search...";
    placeholder-color: @fg-dim;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    fixed-height:     true;
    padding:          8px 0;
    scrollbar:        false;
    dynamic:          false;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          8px 16px;
    spacing:          8px;
}

element selected {
    background-color: @bg-alt;
    text-color:       @accent;
    border-radius:    6px;
    margin:           0 8px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold underline;
}
