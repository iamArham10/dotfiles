# Zathura configuration file
# Location: ~/.config/zathura/zathurarc

# ===== UI Settings =====
set selection-clipboard clipboard
set window-title-basename true
set statusbar-h-padding 1
set statusbar-v-padding 1

# ===== Color Scheme (Dark) =====
set notification-error-bg       "#dc322f"
set notification-error-fg       "#fdf6e3"
set notification-warning-bg     "#dc322f"
set notification-warning-fg     "#fdf6e3"
set notification-bg             "#002b36"
set notification-fg             "#fdf6e3"

set completion-bg               "#073642"
set completion-fg               "#93a1a1"
set completion-group-bg         "#002b36"
set completion-group-fg         "#839496"
set completion-highlight-bg     "#586e75"
set completion-highlight-fg     "#eee8d5"

set index-bg                    "#073642"
set index-fg                    "#93a1a1"
set index-active-bg             "#586e75"
set index-active-fg             "#eee8d5"

set inputbar-bg                 "#073642"
set inputbar-fg                 "#93a1a1"
set statusbar-bg                "#073642"
set statusbar-fg                "#93a1a1"

set highlight-color             "rgba(38,139,169,0.35)"
set highlight-active-color      "rgba(38,139,210,0.45)"

set default-bg                  "#002b36"
set default-fg                  "#93a1a1"
set render-loading              true
set render-loading-fg           "#073642"
set render-loading-bg           "#002b36"

# Recolor mode (for dark background reading)
# Default theme: Solarized-style dark
set recolor-lightcolor          "#002b36"
set recolor-darkcolor           "#93a1a1"
set recolor                     "false"
set recolor-keephue             "false"

# Extra recolor themes (triggered via shortcuts below):
#   - Warm sepia:     bg=#1f1a14, fg=#f3eacb
#   - Light sepia:    bg=#fdf6e3, fg=#3b3222

# ===== Scrolling & Zoom =====
set scroll-step 50
set scroll-hstep 50
set scroll-full-overlap 0.01
set scroll-wrap false

set zoom-min 10
set zoom-max 1000
set zoom-step 10

# ===== Page Settings =====
set adjust-open "best-fit"
set pages-per-row 1
set first-page-column "1:1"

# ===== Keybindings =====
# Zoom
map + zoom in
map - zoom out
map = zoom in
map _ zoom out

# Navigation
map J scroll half-down
map K scroll half-up
map <C-d> scroll half-down
map <C-u> scroll half-up

# Page navigation
map <C-n> navigate next
map <C-p> navigate previous

# Rotation
map r rotate
map R rotate rotate

# Fullscreen
map f toggle_fullscreen
map <F11> toggle_fullscreen

# Index/Table of contents
map <Tab> toggle_index

# Recolor toggle (for night reading)
map <C-r> recolor

# Recolor theme shortcuts
# Ctrl-1: Solarized-style dark (default)
map <C-1> feedkeys ":set recolor-lightcolor '#002b36'<Return>:set recolor-darkcolor '#93a1a1'<Return>:set recolor true<Return>"

# Ctrl-2: Warm sepia dark
map <C-2> feedkeys ":set recolor-lightcolor '#1f1a14'<Return>:set recolor-darkcolor '#f3eacb'<Return>:set recolor true<Return>"

# Ctrl-3: Light sepia / paper-like
map <C-3> feedkeys ":set recolor-lightcolor '#fdf6e3'<Return>:set recolor-darkcolor '#3b3222'<Return>:set recolor true<Return>"

# Search
map n search forward
map N search backward

# ===== Misc =====
set incremental-search true
set database sqlite
set synctex true
set synctex-editor-command "nvim --headless -c \"VimtexInverseSearch %{line} '%{input}'\""
