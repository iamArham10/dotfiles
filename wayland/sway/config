# Sway Config - Minimal and Fast
# https://github.com/swaywm/sway/wiki

#==============================================================================
# VARIABLES
#==============================================================================
set $mod Mod4
set $term ghostty
set $menu fuzzel
set $laptop eDP-1
set $external HDMI-A-1


#==============================================================================
# Drag Floating windows by holding $mod and left mouse button
#==============================================================================
floating_modifier $mod normal

#==============================================================================
# OUTPUT (MONITORS) CONFIGURATION
#==============================================================================
# Run `swaymsg -t get_outputs` to get monitor names
# Layout: External monitor ABOVE laptop

# Layout: External monitor (left), Laptop (right)
output $external resolution 1920x1080 position 0 0
output $laptop resolution 1920x1080 position 1920 0 scale 1.5

# External monitor colors: Viewing Mode = Multimedia, Sharpness = Level 4
exec_always ddcutil setvcp dc 3 --bus 4 && ddcutil setvcp 87 4 --bus 4

#==============================================================================
# WORKSPACES - MONITOR BINDINGS
#==============================================================================
# Workspaces 1-6 on laptop
workspace 1 output $laptop
workspace 2 output $laptop
workspace 3 output $laptop
workspace 4 output $laptop
workspace 5 output $laptop
workspace 6 output $laptop
# Workspaces 7-12 on external
workspace 7 output $external
workspace 8 output $external
workspace 9 output $external
workspace 10 output $external
workspace 11 output $external
workspace 12 output $external
#
#==============================================================================
# APPEARANCE - MINIMAL
#==============================================================================
# No titlebars, no borders, no gaps
# default_border none
default_border pixel 2
default_floating_border pixel 1
gaps inner 0
gaps outer 0

# Colors (focused/unfocused) - subtle dark theme
# class                 border  backgr  text    indicator child_border
# client.focused          #444444 #222222 #ffffff #444444   #444444
client.focused          #87ceeb #222222 #ffffff #87ceeb   #87ceeb
client.unfocused        #222222 #111111 #888888 #222222   #222222

# Font
font pango:monospace 7
titlebar_padding 1 1

# Toggle gaps/borders: Super+G = enable gaps+blue borders, Super+Shift+G = disable
bindsym $mod+g gaps inner all set 3, gaps outer all set 2, exec swaymsg 'default_border pixel 5' && swaymsg 'client.focused #4c7899 #285577 #ffffff #2e9ef4 #285577'
bindsym $mod+Shift+g gaps inner all set 0, gaps outer all set 0, exec swaymsg 'default_border none' && swaymsg 'client.focused #444444 #222222 #ffffff #444444 #444444'


smart_borders no_gaps

#==============================================================================
# KEY BINDINGS - APPLICATIONS
#==============================================================================
# Terminal
bindsym $mod+Return exec $term

# App Launcher
bindsym $mod+d exec $menu

# File Manager (Yazi in terminal)
bindsym $mod+n exec $term -e yazi

# Notes (Simplenote)
bindsym $mod+o exec com.simplenote.Simplenote --ozone-platform=wayland

# Kill focused window
bindsym $mod+Shift+q kill

# Reload config
bindsym $mod+Shift+c reload

# Exit menu (wlogout)
bindsym $mod+Shift+e exec wlogout -b 4 -m 300 -c ~/.config/wlogout/style.css -l ~/.config/wlogout/layout -p layer-shell

# Lock screen
bindsym $mod+l exec swaylock -c 000000

# Toggle waybar visibility
bindsym $mod+Shift+b exec killall -SIGUSR1 waybar

#==============================================================================
# KEY BINDINGS - WORKSPACES
#==============================================================================
# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+minus workspace number 11
bindsym $mod+equal workspace number 12

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Shift+minus move container to workspace number 11
bindsym $mod+Shift+equal move container to workspace number 12

#==============================================================================
# KEY BINDINGS - WINDOW MANAGEMENT
#==============================================================================
# Move focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
# Note: $mod+l is lock screen

# Grid workspace navigation (see grid-nav.sh for layout)
bindsym $mod+Control+Up exec ~/.config/sway/grid-nav.sh up
bindsym $mod+Control+Down exec ~/.config/sway/grid-nav.sh down
bindsym $mod+Control+Left exec ~/.config/sway/grid-nav.sh left
bindsym $mod+Control+Right exec ~/.config/sway/grid-nav.sh right

# Grid navigation + move window along
bindsym $mod+Control+Shift+Up exec ~/.config/sway/grid-nav.sh up -m
bindsym $mod+Control+Shift+Down exec ~/.config/sway/grid-nav.sh down -m
bindsym $mod+Control+Shift+Left exec ~/.config/sway/grid-nav.sh left -m
bindsym $mod+Control+Shift+Right exec ~/.config/sway/grid-nav.sh right -m

# Move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split direction
bindsym $mod+b splith
bindsym $mod+v splitv

# Layout modes
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Fullscreen
bindsym $mod+f fullscreen

# Toggle floating
bindsym $mod+Shift+space floating toggle

# Focus floating/tiled
bindsym $mod+space focus mode_toggle

# Resize mode
mode "resize" {
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px
    bindsym h resize shrink width 20px
    bindsym j resize grow height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym $mod+Shift+s sticky toggle

#==============================================================================
# KEY BINDINGS - SYSTEM CONTROLS
#==============================================================================
# Brightness (laptop)
bindsym XF86MonBrightnessUp exec brightnessctl set +3%
bindsym XF86MonBrightnessDown exec brightnessctl set 3%-
bindsym $mod+F6 exec brightnessctl set +1%
bindsym $mod+F5 exec brightnessctl set 1%-

# Brightness (external monitor via DDC)
bindsym $mod+F8 exec ddcutil setvcp 10 + 10
bindsym $mod+F7 exec ddcutil setvcp 10 - 10

# Volume
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym $mod+F3 exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym $mod+F2 exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym $mod+F1 exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Screenshot (Super+P = annotate full, Super+Shift+P = select area & copy)
bindsym $mod+p exec grim - | satty -f -
bindsym $mod+Shift+p exec grim -g "$(slurp)" - | satty -f - --initial-tool crop --copy-command wl-copy --early-exit

# File picker (fzf in floating ghostty)
bindsym $mod+i exec ghostty \
    --title=fzf-picker \
    -e bash -c "~/.config/fuzzel/fuzzel-search.sh"

for_window [title="fzf-picker"] {
    floating enable
    resize set 800 560
    move position center
    border pixel 1
}


for_window [title="wifi-manager"] {
    floating enable
    resize set 500 400
    move position center
    border pixel 1
}

# Clipboard super + shift + v
bindsym $mod+Shift+v exec cliphist list | wofi --dmenu | cliphist decode | wl-copy

# Night light toggle (Super+Shift+N)
bindsym $mod+Shift+n exec pkill wlsunset && notify-send "Night Light OFF" || (wlsunset -t 3500 -T 9500 & notify-send "Night Light ON")

# Big cursor for focused reading
bindsym $mod+Mod1+c exec 'gsettings set org.gnome.desktop.interface cursor-size 128 && swaymsg seat seat0 xcursor_theme Adwaita 128'
bindsym $mod+Mod1+Shift+c exec 'gsettings set org.gnome.desktop.interface cursor-size 32 && swaymsg seat seat0 xcursor_theme Adwaita 32'


#==============================================================================
# INPUT CONFIGURATION
#==============================================================================
input type:touchpad {
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    pointer_accel -0.3
}

input type:pointer {
    middle_emulation enabled
    pointer_accel 0.5
}

input type:keyboard {
    xkb_options caps:escape
    repeat_delay 300
    repeat_rate 30
}

#==============================================================================
# AUTOSTART
#==============================================================================
# Portal environment - export session vars for D-Bus services
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway TERMINAL=ghostty

# Status bar
exec waybar

# Notification center
exec swaync

# Network & Bluetooth handled by waybar modules (click to open)
# exec nm-applet --indicator
# exec blueman-applet

# touchpad gestures
exec libinput-gestures-setup start

# clipboard
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# Idle management (lock after 5 min, screen off after 10 min)
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 000000'

# Set background
# exec swaybg -c "#1a1a2e"
exec_always swaybg -c "#262626"
# output * bg /home/arham/Pictures/wallpaper/aesthetic-background-with-abstract-neon-led-light-effect.jpg fill

# start keyring
exec --no-startup-id gnome-keyring-daemon --start --components=secrets

# Polkit authentication agent
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
