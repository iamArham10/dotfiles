" ============================================================================
" IDEAVIMRC - Synced with Neovim Configuration
" ============================================================================

" vim settings
set scrolloff=5
set history=1000

" status bar
set showmode

" leader
map <space> <nop>
let mapleader="\<space>"

" find and replace
set hlsearch
set incsearch
set ignorecase
set smartcase
set gdefault

" Clear search highlighting (nvim uses <Esc>, keeping both)
nmap <leader>nh :noh<CR>
nmap <Esc> :noh<CR>

" ideavim settings
set ideajoin
set ideamarks
set idearefactormode=normal
set ideastatusicon=gray

" ============================================================================
" NAVIGATION - Aligned with Nvim
" ============================================================================

" Better HJKL (IdeaVim specific - keeping these)
map H ^
map L $
" NOTE: J/K remapped to paragraph motion - differs from nvim where K=hover
" If you want nvim behavior, comment these out
map J }
" K is used for QuickJavaDoc (hover) to match nvim - see below

" Better escape (matches nvim's better-escape plugin)
imap jk <Esc>
imap jj <Esc>

" Location navigation
nmap <C-o> <Action>(Back)
nmap <C-i> <Action>(Forward)

" ============================================================================
" BUFFER/TAB MANAGEMENT - Aligned with Nvim
" ============================================================================

" Buffer navigation (nvim: <S-h>/<S-l>, but conflicts with H/L above)
" Using [b/]b which is also common in nvim
nmap [b <Action>(PreviousTab)
nmap ]b <Action>(NextTab)
nmap <Tab> <Action>(NextTab)
nmap <C-Tab> <Action>(PreviousTab)

" Buffer operations (aligned with nvim <leader>b prefix)
nmap <leader>bd <Action>(CloseContent)
nmap <leader>bn <Action>(NewFile)
nmap <leader>ba <Action>(CloseAllEditors)
nmap <leader>bo <Action>(CloseAllEditorsButActive)
nmap <leader>bp <Action>(CloseAllUnpinnedEditors)

" Pin tab
nmap <leader>p <Action>(PinActiveEditorTab)

" Go to tab by number (keeping original)
nmap <leader>1 <Action>(GoToTab1)
nmap <leader>2 <Action>(GoToTab2)
nmap <leader>3 <Action>(GoToTab3)
nmap <leader>4 <Action>(GoToTab4)
nmap <leader>5 <Action>(GoToTab5)
nmap <leader>6 <Action>(GoToTab6)
nmap <leader>7 <Action>(GoToTab7)
nmap <leader>8 <Action>(GoToTab8)
nmap <leader>9 <Action>(GoToTab9)

" ============================================================================
" WINDOW/SPLIT MANAGEMENT - Aligned with Nvim
" ============================================================================

" Split windows (nvim style)
nmap <leader>sv <Action>(SplitVertically)
nmap <leader>sH <Action>(SplitHorizontally)
nmap <leader>se <Action>(Unsplit)
nmap <leader>sx <Action>(Unsplit)

" Move tabs to splits (keeping original)
map <leader>sj <Action>(MoveTabDown)
map <leader>sk <Action>(MoveTabUp)
map <leader>sl <Action>(MoveTabRight)
map <leader>sh <Action>(MoveTabLeft)

" Window navigation (matches nvim exactly)
nmap <C-h> <C-w>h
nmap <C-j> <C-w>j
nmap <C-k> <C-w>k
nmap <C-l> <C-w>l

" Window management
nmap <C-p> <Action>(JumpToLastWindow)
nmap <M-i> <Action>(PrevSplitter)
nmap <M-o> <Action>(NextSplitter)

nmap <leader>ww <Action>(HideAllWindows)
nmap <leader>wk <Action>(StretchSplitToTop)
nmap <leader>wj <Action>(StretchSplitToBottom)
nmap <leader>wh <Action>(StretchSplitToLeft)
nmap <leader>wl <Action>(StretchSplitToRight)
nmap <leader>wm <Action>(MaximizeEditorInSplit)
nmap <leader>wu <Action>(UnsplitAll)

" ============================================================================
" FILE OPERATIONS - Aligned with Nvim
" ============================================================================

" Save/quit (from nvim)
nmap <leader>w :w<CR>
nmap <leader>q :q<CR>
nmap <leader>Q :qa!<CR>

" File explorer (nvim <leader>e)
nmap <leader>e <Action>(ActivateProjectToolWindow)
nmap <leader>ef <Action>(SelectInProjectView)

" File operations
nmap <leader>of <Action>(OpenFile)
nmap <leader>yp <Action>(CopyAbsolutePath)
nmap <leader>fy <Action>(CopyAbsolutePath)
nmap <leader>fn <Action>(CopyFileName)

" Recent files (nvim uses <leader>fr)
nmap <leader>fr <Action>(RecentFiles)
nmap <leader>rf <Action>(RecentFiles)
nmap <leader>rl <Action>(RecentLocations)
nmap <leader>rp <Action>(ManageRecentProjects)

" Show file info
nmap <leader>fp <Action>(ShowFilePath)
nmap <leader>si <Action>(SelectIn)

" ============================================================================
" FIND/SEARCH - Aligned with Nvim Telescope
" ============================================================================

" Find files (nvim <leader>ff)
nmap <leader>ff <Action>(GotoFile)
nmap gf <Action>(GotoFile)

" Find/grep in files (nvim <leader>fg)
nmap <leader>fg <Action>(FindInPath)

" Find buffers (nvim <leader>fb)
nmap <leader>fb <Action>(Switcher)

" Find help/actions
nmap <leader>fh <Action>(HelpTopics)
nmap <leader>fk <Action>(GotoAction)

" Find string under cursor (nvim <leader>fc -> changed to avoid conflict)
nmap <leader>fw <Action>(FindWordAtCaret)

" Git status files
nmap <leader>fS <Action>(FileStructurePopup)

" Search everywhere
nmap ga <Action>(SearchEverywhere)
nmap <leader>a <Action>(GotoAction)

" Replace in path
nmap <leader>sr <Action>(ReplaceInPath)

" ============================================================================
" CODE NAVIGATION - Aligned with Nvim LSP
" ============================================================================

" Go to definition (matches nvim gd)
nmap gd <Action>(GotoDeclaration)

" Go to declaration (matches nvim gD)
nmap gD <Action>(GotoTypeDeclaration)

" Go to references (matches nvim gR)
nmap gR <Action>(FindUsages)
nmap gr <Action>(ShowUsages)

" Go to implementation (matches nvim gi)
nmap gi <Action>(GotoImplementation)
nmap gI <Action>(QuickImplementations)

" Go to type definition (matches nvim gt in LSP)
nmap gt <Action>(GoToTest)
nmap gT <Action>(TextSearchAction)

" Other goto mappings
nmap go <Action>(GotoSuperMethod)
nmap gc <Action>(GotoClass)
nmap gs <Action>(GotoSymbol)
nmap gn <Action>(ShowNavBar)
nmap gm %

" Hover documentation (matches nvim K for LSP hover)
nmap K <Action>(QuickJavaDoc)

" ============================================================================
" DIAGNOSTICS - Aligned with Nvim
" ============================================================================

" Navigate diagnostics (nvim [d/]d, keeping [g/]g as well)
nmap [d <Action>(GotoPreviousError)
nmap ]d <Action>(GotoNextError)
nmap [g <Action>(GotoPreviousError)
nmap ]g <Action>(GotoNextError)

" Show diagnostic (nvim <leader>d)
nmap <leader>d <Action>(ShowErrorDescription)

" Diagnostic list (nvim <leader>xb for buffer diagnostics)
nmap <leader>xb <Action>(ActivateProblemsViewToolWindow)

" Trouble-like diagnostics (keeping nvim convention)
nmap <leader>xx <Action>(ActivateProblemsViewToolWindow)
nmap <leader>xw <Action>(ActivateProblemsViewToolWindow)
nmap <leader>xd <Action>(ShowErrorDescription)
nmap <leader>xq <Action>(ActivateProblemsViewToolWindow)

" Next/prev usage
nmap [u <Action>(GotoPrevElementUnderCaretUsage)
nmap ]u <Action>(GotoNextElementUnderCaretUsage)
nmap [o <Action>(PreviousOccurence)
nmap ]o <Action>(NextOccurence)
nmap [m <Action>(MethodUp)
nmap ]m <Action>(MethodDown)
nmap [c <Action>(JumpToLastChange)
nmap ]c <Action>(JumpToNextChange)

" ============================================================================
" CODE ACTIONS - Aligned with Nvim LSP
" ============================================================================

" Code actions (nvim <leader>ca)
nmap <leader>ca <Action>(ShowIntentionActions)
vmap <leader>ca <Action>(ShowIntentionActions)
nmap <leader>qf <Action>(ShowIntentionActions)

" Rename (matches nvim <leader>rn)
nmap <leader>rn <Action>(RenameElement)

" Format code (nvim <leader>mp for format)
nmap <leader>mp <Action>(ReformatCode)
nmap <leader>fc <Action>(ReformatCode)

" Organize imports (nvim convention)
nmap <leader>oi <Action>(OptimizeImports)

" ============================================================================
" COMMENTING - Aligned with Nvim Comment.nvim
" ============================================================================

" Line comment (nvim gcc)
map gcc <Action>(CommentByLineComment)
map <leader>c <Action>(CommentByLineComment)

" Block comment (nvim gbc)
map gbc <Action>(CommentByBlockComment)
map <leader>C <Action>(CommentByBlockComment)

" ============================================================================
" CODE GENERATION & REFACTORING
" ============================================================================

" Generate
nmap <leader>gc <Action>(Generate)
nmap <leader>om <Action>(OverrideMethods)
nmap <leader>im <Action>(ImplementMethods)

" Refactoring menu
nmap <leader>re <Action>(Refactorings.QuickListPopupAction)
nmap <leader>uw <Action>(Unwrap)
map <leader>sw <Action>(SurroundWith)
nmap <leader>sd <Action>(SafeDelete)

" Inspect code
nmap <leader>ic <Action>(InspectCode)
nmap <leader>so <Action>(SelectAllOccurrences)

" Highlight usages
nmap <leader>hl <Action>(HighlightUsagesInFile)

" Quick preview/definition
nmap <leader>qp <Action>(QuickPreview)
nmap <leader>qd <Action>(QuickDefinition)
nmap <leader>qD <Action>(QuickTypeDefinition)
nmap <leader>qm <Action>(QuickJavaDoc)

" Hierarchy views
nmap <leader>hc <Action>(CallHierarchy)
nmap <leader>hm <Action>(MethodHierarchy)
nmap <leader>ht <Action>(TypeHierarchy)

" ============================================================================
" GIT - Aligned with Nvim Gitsigns/Fugitive
" ============================================================================

" Git hunks (matches nvim gitsigns)
nmap ]h <Action>(VcsShowNextChangeMarker)
nmap [h <Action>(VcsShowPrevChangeMarker)
nmap <leader>hp <Action>(VcsShowCurrentChangeMarker)
nmap <leader>hr <Action>(Vcs.RollbackChangedLines)
nmap <leader>hb <Action>(Annotate)
nmap <leader>hd <Action>(Compare.SameVersion)

" Git operations (matches nvim fugitive)
nmap <leader>gs <Action>(Git.Menu)
nmap <leader>gc <Action>(CheckinProject)
nmap <leader>gp <Action>(Vcs.Push)
nmap <leader>gl <Action>(Vcs.UpdateProject)
nmap <leader>gb <Action>(Git.Branches)

" VCS menu
nmap <leader>v <Action>(VcsGroups)

" ============================================================================
" RUN & DEBUG
" ============================================================================

" Run
nmap <leader>rc <Action>(ContextRun)
nmap <leader>rx <Action>(ChooseRunConfiguration)
nmap <leader>rr <Action>(Rerun)
nmap <leader>rt <Action>(RunTests)
nmap <leader>rst <Action>(Stop)

" Debug
nmap <leader>dc <Action>(ContextDebug)
nmap <leader>dx <Action>(Debug)
nmap <leader>db <Action>(ToggleLineBreakpoint)
nmap <leader>de <Action>(EditBreakpoint)
nmap <leader>dv <Action>(ViewBreakpoints)

" Build
nmap <leader>bb <Action>(BuildMenu)

" ============================================================================
" TERMINAL - Aligned with Nvim Toggleterm
" ============================================================================

nmap <leader>tt <Action>(ActivateTerminalToolWindow)
nmap <leader>tc <Action>(Terminal.OpenInTerminal)
nmap <leader>tf <Action>(Terminal.OpenInTerminal)
nmap <C-\> <Action>(ActivateTerminalToolWindow)

" ============================================================================
" MOVEMENT & EDITING - Aligned with Nvim
" ============================================================================

" Move lines up/down (matches nvim <A-j>/<A-k>)
nmap <A-j> <Action>(MoveLineDown)
nmap <A-k> <Action>(MoveLineUp)
vmap <A-j> <Action>(MoveLineDown)
vmap <A-k> <Action>(MoveLineUp)

" Centered scrolling (matches nvim)
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap n nzzzv
nnoremap N Nzzzv

" Paste without yanking in visual mode (matches nvim)
vnoremap p "_dP
xnoremap <leader>p "_dP

" Delete without yanking (matches nvim)
nmap <leader>D "_d
vmap <leader>D "_d

" Select all and copy (keeping original)
nmap <C-a> ggVG"+y

" Continuous shift (matches nvim)
xnoremap < <gv
xnoremap > >gv

" ============================================================================
" FOLDING
" ============================================================================

nmap zz <Action>(EditorScrollToCenter)
nmap za <Action>(ExpandCollapseToggleAction)
nmap zc <Action>(CollapseAllRegions)
nmap zo <Action>(ExpandAllRegions)

" ============================================================================
" ZEN MODE
" ============================================================================

nmap <leader>z <Action>(ToggleZenMode)

" ============================================================================
" MENU SHORTCUTS (IDE specific - keeping)
" ============================================================================

nmap <leader>mm <Action>(MainMenu)
nmap <leader>ma <Action>(AnalyzeMenu)
nmap <leader>mb <Action>(BuildMenu)
nmap <leader>mc <Action>(CodeMenu)
nmap <leader>mf <Action>(FindMenuGroup)
nmap <leader>mg <Action>(GoToMenu)
nmap <leader>ms <Action>(ScopeViewPopupMenu)
nmap <leader>mt <Action>(EditorTabPopupMenu)
nmap <leader>mw <Action>(ToolWindowsGroup)

" ============================================================================
" BOOKMARKS
" ============================================================================

nmap mm <Action>(ToggleBookmark)
nmap ms <Action>(ShowBookmarks)

" ============================================================================
" TODO & TASKS
" ============================================================================

nmap <leader>to <Action>(ActivateTODOToolWindow)
nmap <leader>ft <Action>(ActivateTODOToolWindow)
nmap <leader>ts <Action>(tasks.goto)

" ============================================================================
" SESSION (nvim auto-session equivalent)
" ============================================================================

nmap <leader>ss <Action>(SaveAll)
nmap <leader>sr <Action>(ManageRecentProjects)

" ============================================================================
" MISC
" ============================================================================

" Join lines
nmap \\jl <Action>(EditorJoinLines)

" Gist
nmap \\cg <Action>(Github.Create.Gist)

" IdeaVim settings
nmap \\v <Action>(VimActions)

" Local history
nmap <leader>lh <Action>(LocalHistory.ShowHistory)

" ============================================================================
" IDEAVIM PLUGINS (bundle plugins)
" ============================================================================

" Text objects
set vim-paragraph-motion
set textobj-indent
set argtextobj

" EasyMotion (requires IdeaVim-EasyMotion + AceJump plugins)
set easymotion

" Highlighted yank
set highlightedyank
let g:highlightedyank_highlight_duration = "1000"
let g:highlightedyank_highlight_color = "rgba(57, 197, 187, 155)"

" Surround (like nvim-surround)
set surround

" Exchange (like vim-exchange)
set exchange

" NERDTree
set NERDTree

" Replace with register
set ReplaceWithRegister

" ============================================================================
" TRANSLATION PLUGIN (IDE specific)
" ============================================================================

nmap \\tt <Action>($ShowTranslationDialogAction)
nmap \\ts <Action>($TranslateTextComponent)
nmap \\ti <Action>($InclusiveTranslateAction)
nmap \\te <Action>($ExclusiveTranslateAction)

" ============================================================================
" STRING MANIPULATION PLUGIN (IDE specific)
" ============================================================================

nmap <leader>sm <Action>(osmedile.intellij.stringmanip.PopupChoiceAction)

" ============================================================================
" CODE SCREENSHOT PLUGIN (IDE specific)
" ============================================================================

nmap \\cs <Action>(one.util.ideaplugin.screenshoter.CopyImageAction)

" ============================================================================
" GRADLE (keeping original)
" ============================================================================

nmap <leader>gg <Action>(Gradle.ExecuteTask)
