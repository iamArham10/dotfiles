[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[user]
	name = arham
	email = imranarham798@gmail.com

[core]
    pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
    light = false
	side-by-side = false
	line-numbers = true
    syntax-theme = Dracula
	keep-plus-minus-markers = true
	hunk-header-style = syntax
	file-style = bold yellow
	commit-style = omit
	blame-code-style = syntax

[merge]
    conflictstyle = diff3
	tool = nvimdiff

[diff]
    colorMoved = default
	tool = nvimdiff
[difftool]
	prompt = true
[init]
	defaultBranch = main
[fem]
	dev = global fem
